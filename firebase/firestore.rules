rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ansomaacharity112@icloud.com'
        && request.auth.token.email_verified == true;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.category in ['Crop Top', 'Short Top', 'Dress', 'Accessories']
        && request.resource.data.sizes is list
        && request.resource.data.image is string;
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasAll([
          'customerName', 'customerEmail', 'phone', 'address', 'payment', 'items', 'total', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'customerName', 'customerEmail', 'phone', 'address', 'payment', 'items', 'total', 'status', 'createdAt'
        ])
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() >= 2
        && request.resource.data.customerEmail == request.auth.token.email
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 9
        && request.resource.data.address is string
        && request.resource.data.address.size() >= 5
        && request.resource.data.payment in ['Cash on Delivery', 'Mobile Money']
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 20
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.status == 'Pending';
      allow read, update, delete: if isAdmin();
    }

    match /mail/{mailId} {
      allow read, write: if false;
    }
  }
}
